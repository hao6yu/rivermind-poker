{
  "name": "rivermind-poker",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@supabase/supabase-js": "2.111.0",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-screen-orientation": "~9.0.9",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "19.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "vitest": "4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eval:ai": "PRINT_AI_METRICS=1 vitest run src/domain/poker/__tests__/ai.test.ts --reporter=verbose",
    "eval:multiway-ai": "PRINT_MULTIWAY_AI_METRICS=1 vitest run src/domain/poker/__tests__/multiwayAi.test.ts --reporter=verbose",
    "eval:championship-ai": "PRINT_CHAMPIONSHIP_METRICS=1 PRINT_CHAMPIONSHIP_STYLE_METRICS=1 vitest run src/domain/poker/__tests__/championshipSimulation.test.ts --reporter=verbose --disableConsoleIntercept",
    "eval:coach": "node --env-file=.env scripts/evaluate-coach.mjs",
    "eas:config:ios": "pnpm dlx eas-cli@21.4.0 config --platform ios --profile production",
    "eas:config:android": "pnpm dlx eas-cli@21.4.0 config --platform android --profile production",
    "build:android:preview": "pnpm dlx eas-cli@21.4.0 build --platform android --profile preview",
    "build:android:release": "pnpm dlx eas-cli@21.4.0 build --platform android --profile production",
    "build:ios:simulator": "pnpm dlx eas-cli@21.4.0 build --platform ios --profile simulator",
    "build:ios:preview": "pnpm dlx eas-cli@21.4.0 build --platform ios --profile preview",
    "build:ios:release": "bash scripts/build-ios-release.sh",
    "build:ios:release:local": "bash scripts/build-ios-local-release.sh",
    "build:ios:testflight": "pnpm dlx eas-cli@21.4.0 build --platform ios --profile production",
    "submit:ios:testflight": "bash scripts/submit-ios-release.sh",
    "release:check": "node scripts/run-release-check.mjs",
    "verify:coach-quota": "node --env-file=.env scripts/verify-coach-quota.mjs",
    "verify:mobile-secrets": "node scripts/verify-mobile-secrets.mjs",
    "verify:multiplayer-edge": "node scripts/verify-multiplayer-edge.mjs",
    "verify:release-config": "node scripts/verify-release-config.mjs",
    "verify:rls": "node --env-file=.env scripts/verify-persistence-rls.mjs",
    "test:multiplayer-integration": "vitest run --config vitest.integration.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
