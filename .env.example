# Values prefixed with EXPO_PUBLIC_ are safe to bundle in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# OPTIONAL override: absolute base URL of the hosted Edge Functions. The
# accessor appends /avatar-access/<roomId>/<avatarId>?v=<version> to it.
# When unset, the base is derived from EXPO_PUBLIC_SUPABASE_URL as
# <EXPO_PUBLIC_SUPABASE_URL>/functions/v1. Set only when the worker is served
# from a different absolute base (e.g. a custom domain).
# EXPO_PUBLIC_AVATAR_ACCESS_URL=https://<region>.supabase.co/functions/v1
