# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
!.gitignore

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
/artifacts/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase local state
supabase/.branches/
supabase/.temp/

# local AI evaluation output
.eval-results/

# local agent worktrees and caches
.claude/
