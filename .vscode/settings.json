{
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "terminal.integrated.env.osx": {
    "DEVELOPER_DIR": "/Applications/Xcode-beta.app/Contents/Developer",
    "PATH": "${env:HOME}/.nvm/versions/node/v22.19.0/bin:${env:PATH}"
  },
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
